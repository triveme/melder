PORT=3333
FRONTEND_HOST=http://localhost:3000
FRONTEND_HOST_WWW=http://www.localhost:3000
SECRET=#########
DB_HOST=localhost
DB_USER=#########
DB_PASSWORD=#########
DB_DATABASE=#########
DEFAULT_ADMIN_USERNAME=#########
DEFAULT_ADMIN_PASSWORD=#########
IMAGE_DIR=/public/images

SENSOR_CRON="0 6 * * *" # Cronjob to check filling levels and send emails if necessary (every day at 6am)
SENSOR_SOURCE=######### # ThingsBoard API URL
SENSOR_USER=######### # ThingsBoard API username
SENSOR_PASSWORD=######### # ThingsBoard API password
SENSOR_GLASS_CONTAINERS="/plugins/telemetry/DEVICE/0-replace-me/values/timeseries,/plugins/telemetry/DEVICE/1-replace-me/values/timeseries" # Comma-separated list of URL parts for the glass containers
SENSOR_GLASS_CONTAINER_TRIGGER=80 # Percentage of filling level that triggers an email (80%)
SENSOR_GLASS_CONTAINER_RECIPIENTS="bar@example.com, baz@example.com" # Comma-separated list of email addresses that receive the email

# RECEIVING EMAIL
ROAD_SIGN: ########,

